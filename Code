}

// 그 날짜 칸들을 지역끼리 붙도록 다시 늘어놓아요 (칸 색·글자 서식·메모는 그대로 옮겨요)
function regroupDay(day) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var b = blockAt(day);
    if (!b) return { ok: false, error: 'nodate' };
    var rg = blockRange(b), vals = rg.getValues(), nR = vals.length, nC = vals[0].length;
    var cells = [], order = [], groups = {};
    for (var i = 0; i < nR; i++) for (var j = 0; j < nC; j++) {
      if (String(vals[i][j]).trim() === '') continue;
      var reg = regionInText(vals[i][j]);
      var key = reg || '~기타';
      if (!groups[key]) { groups[key] = []; if (reg) order.push(key); }
      groups[key].push([i, j]);
    }
    if (groups['~기타']) order.push('~기타');
    order.forEach(function (k) { cells = cells.concat(groups[k]); });
    var before = [];
    for (var a = 0; a < nR; a++) for (var c = 0; c < nC; c++) if (String(vals[a][c]).trim() !== '') before.push([a, c]);
    if (JSON.stringify(before) === JSON.stringify(cells)) return { ok: true, moved: 0 };
    var notes = rg.getNotes();
    var ss = scheduleBook(), tmp = ss.insertSheet('_정리중_' + Date.now());
    try {
      rg.copyTo(tmp.getRange(1, 1));                 // 원래 칸들을 임시 탭에 복사
      rg.clear();                                    // 날짜 칸들을 비우고
      var newNotes = [];
      for (var x = 0; x < nR; x++) { newNotes.push([]); for (var y = 0; y < nC; y++) newNotes[x].push(''); }
      cells.forEach(function (src, k) {               // 지역 순서대로 왼쪽 위부터 다시 채우기
        var tr = Math.floor(k / nC), tc = k % nC;
        tmp.getRange(src[0] + 1, src[1] + 1).copyTo(rg.getCell(tr + 1, tc + 1));
        newNotes[tr][tc] = notes[src[0]][src[1]] || '';
      });
      rg.setNotes(newNotes);
    } finally { ss.deleteSheet(tmp); }
    // 예약 탭의 칸 주소도 새 자리로 고쳐요
    var sh = sheet('book'), data = sh.getDataRange().getValues(), cWhere = data[0].indexOf('일정표 칸') + 1;
    var nn = rg.getNotes(), where = {};
    for (var p = 0; p < nR; p++) for (var q = 0; q < nC; q++) {
      var m = String(nn[p][q]).match(/홈페이지 (?:예약|A\/S) ([AB]\d+)/);
      if (m) where[m[1]] = b.sheet.getName() + '!' + rg.getCell(p + 1, q + 1).getA1Notation();
    }
    for (var w = 1; w < data.length; w++) if (where[String(data[w][0])] && cWhere) sh.getRange(w + 1, cWhere).setValue(where[String(data[w][0])]);
    clearSummary();
    return { ok: true, moved: cells.length };
  } finally { lock.releaseLock(); }
}

function listClosed() { return rows('closed').map(function (r) { return dateStr(r['날짜']); }); }

function setClosed(date, closed) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date || '')) return { ok: false, error: 'date' };
