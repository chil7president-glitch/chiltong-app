    var sh = sheet('book'), data = sh.getDataRange().getValues(), head = data[0];
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) !== String(id)) continue;
      var r = {}; head.forEach(function (h, j) { r[h] = data[i][j]; });
      if (!sameOwner(r, name, phone)) return { ok: false, error: 'auth' };
      if (r['상태'] === '취소') return { ok: false, error: 'cancelled' };
