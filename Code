// 예약 탭에 적어 둔 주소로 일정표 칸을 찾아요. 누군가 칸을 옮겼으면(메모가 다르면) null
function scheduleCell(where, id, day) {
  if (where) {
    var p = String(where).split('!'), sh = scheduleBook().getSheetByName(p[0]);
    if (sh) { var cell = sh.getRange(p[1]); if (String(cell.getNote()).indexOf(id) >= 0) return cell; }
  }
  if (!day) return null;
  var b = blockAt(day);   // 칸이 옮겨졌으면 그 날짜 칸들의 메모에서 다시 찾아요
  if (!b) return null;
  var rg = blockRange(b), notes = rg.getNotes();
  for (var i = 0; i < notes.length; i++) for (var j = 0; j < notes[i].length; j++)
    if (String(notes[i][j]).indexOf(id) >= 0) return rg.getCell(i + 1, j + 1);
  return null;
}

// 예약 탭 한 줄 → 일정표 칸에 적을 내용
function rowToRec(r, day) {
  return { day: day != null ? day : dateStr(r['시공일']), name: r['이름'], phone: String(r['연락처']), apt: r['아파트'], dong: String(r['동'] || ''), ho: String(r['호'] || ''),
    memo: r['남긴 말'], color: r['색상'], region: r['지역'], tech: r['기사님'], kind: r['종류'] === 'AS' ? 'AS' : '', symptom: r['증상'], when: r['시공 시기'],
    photoCount: String(r['사진'] || '').split(' ').filter(String).length,
    product: r['시공제품'], access: r['출입방법'], julnun: r['줄눈 일정'], clean: r['입주청소 일정'], callTime: r['통화 편한 시간'] };
}

function setBooking(id, status) {
  if (['접수', '확정', '취소'].indexOf(status) < 0) return { ok: false, error: 'status' };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sh = sheet('book'), data = sh.getDataRange().getValues(), head = data[0];
    var cWhere = head.indexOf('일정표 칸') + 1;
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) !== String(id)) continue;
      var r = {}; head.forEach(function (h, j) { r[h] = data[i][j]; });
      var cell = scheduleCell(r['일정표 칸'], id, dateStr(r['시공일']));
      if (status === '취소') {
        if (cell) cell.clearContent().setBackground(null).clearNote(); // 칸을 비워서 그날 자리가 다시 생겨요
        if (cWhere) sh.getRange(i + 1, cWhere).setValue('');
      } else {
        if (!cell && !r['일정표 칸']) { // 취소했다 되돌리면 다시 적어요
          var d = rowToRec(r);
          var placed = placeInSchedule(d, id);
          if (placed.reason === 'full') return { ok: false, error: 'full' };
          if (cWhere) sh.getRange(i + 1, cWhere).setValue(placed.where || '');
          cell = scheduleCell(placed.where, id);
        }
        if (cell) {
          var t = String(cell.getValue());
          r['상태'] = status;
          if (status === '확정') cell.setValue(t.replace(WAIT_MARK, OK_MARK).replace(AS_WAIT, AS_OK)).setBackground(cellColor(r));
          else cell.setValue(t.replace(OK_MARK, WAIT_MARK).replace(AS_OK, AS_WAIT)).setBackground(cellColor(r));
        }
      }
      sh.getRange(i + 1, 4).setValue(status);
      clearSummary();
      return { ok: true };
    }
    return { ok: false, error: 'notfound' };
  } finally { lock.releaseLock(); }
}

// A/S 방문 날짜 정하기 (관리자) → 그 날짜 줄 빈칸에 적어요. 날짜를 바꾸면 예전 칸은 비워요
function setDay(id, day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day || '')) return { ok: false, error: 'date' };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sh = sheet('book'), data = sh.getDataRange().getValues(), head = data[0];
    var cDay = head.indexOf('시공일') + 1, cWhere = head.indexOf('일정표 칸') + 1;
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) !== String(id)) continue;
      var r = {}; head.forEach(function (h, j) { r[h] = data[i][j]; });
      var d = rowToRec(r, day);
      var oldDay = r['시공일'] ? dateStr(r['시공일']) : '';
      var old = scheduleCell(r['일정표 칸'], id, oldDay);
      if (old && oldDay === day) return { ok: true, cell: String(r['일정표 칸']) }; // 이미 그 날짜에 적혀 있어요
      var placed = placeInSchedule(d, id);
      if (placed.reason === 'full') return { ok: false, error: 'full' };
      if (old) old.clearContent().setBackground(null).clearNote(); // 예전 날짜 칸은 비워요
      sh.getRange(i + 1, cDay).setValue(txt(day));
      if (cWhere) sh.getRange(i + 1, cWhere).setValue(placed.where || '');
      clearSummary();
      return { ok: true, cell: placed.where || '' };
    }
    return { ok: false, error: 'notfound' };
  } finally { lock.releaseLock(); }
}

// 기사님 지정 → 일정표 칸을 그 기사님 색으로
function setTech(id, name) {
  if (name && !techByName(name)) return { ok: false, error: 'tech' };
  var sh = sheet('book'), data = sh.getDataRange().getValues(), head = data[0];
  var cTech = head.indexOf('기사님') + 1;
