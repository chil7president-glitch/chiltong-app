function savePhoto(dataUrl, name, folderName) {
  var m = String(dataUrl).match(/^data:(image\/\w+);base64,(.+)$/);
  if (!m) throw new Error('photo');
  var file = folder(folderName || PHOTO_FOLDER).createFile(Utilities.newBlob(Utilities.base64Decode(m[2]), m[1], name));
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return { id: file.getId(), url: 'https://lh3.googleusercontent.com/d/' + file.getId() };
}

// ---------- 고객이 직접: 내 예약 보기 · 바꾸기 · 취소 (이름 + 연락처가 맞아야 해요) ----------
function digits(v) { return String(v || '').replace(/\D/g, ''); }
function sameOwner(r, name, phone) {
  return digits(phone).length >= 10 && digits(r['연락처']) === digits(phone) && String(r['이름'] || '').replace(/\s/g, '') === String(name || '').replace(/\s/g, '');
}
function daysFromToday(day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(day || ''))) return 9999; // 날짜가 아직 없으면(A/S 일정 미정) 언제든 고칠 수 있어요
  var t = Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd').split('-'), p = String(day).split('-');
  return Math.round((Date.UTC(+p[0], +p[1] - 1, +p[2]) - Date.UTC(+t[0], +t[1] - 1, +t[2])) / 86400000);
}
function publicBooking(r) { // 고객에게 보여줄 것만 (기사님 배정은 빼요)
