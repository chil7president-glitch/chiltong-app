// ---------- 들어오는 요청 ----------
function doGet(e) {
  var action = (e && e.parameter && e.parameter.action) || '';
  try {
    if (action === 'cases') return out({ ok: true, cases: listCases() });
    if (action === 'schedule') return out(scheduleSummary());
    if (action === 'ping') return out({ ok: true, at: now() });
    return out({ ok: false, error: 'unknown' });
  } catch (err) { return out({ ok: false, error: String(err.message || err) }); }
}

function doPost(e) {
  var body = {};
  try { body = JSON.parse(e.postData.contents || '{}'); } catch (x) { return out({ ok: false, error: 'badjson' }); }
  var a = body.action;
  try {
    if (a === 'consult') return out(addConsult(body.data || {}));
    if (a === 'book') return out(addBooking(body.data || {}));
    if (a === 'as') { var asd = body.data || {}; asd.kind = 'AS'; return out(addBooking(asd)); }
    if (a === 'contract') return out(addContract(body.data || {}, body.pdf, body.fileName));
    if (a === 'myBookings') return out(myBookings(body.name, body.phone));
    if (a === 'myUpdate') return out(myUpdate(body.id, body.name, body.phone, body.data || {}));
    if (a === 'myCancel') return out(myCancel(body.id, body.name, body.phone));
    if (a === 'checkPassword') return out(checkPw(body.password) ? { ok: true } : { ok: false, error: 'auth' });
    // 여기부터는 관리자만
    if (!checkPw(body.password)) return out({ ok: false, error: 'auth' });
    if (a === 'bookings') { try { syncTechsFromSheet(); } catch (x) {} }
    if (a === 'bookings') return out({ ok: true, bookings: listBookings(), closed: listClosed(), techs: TECHS.map(function (t) { return { name: t.name, color: t.color, regions: t.regions }; }) });
    if (a === 'setTech') return out(setTech(body.id, body.tech));
    if (a === 'setDay') return out(setDay(body.id, body.day));
    if (a === 'regroup') return out(regroupDay(body.date));
    if (a === 'setBooking') return out(setBooking(body.id, body.status));
    if (a === 'setClosed') return out(setClosed(body.date, body.closed));
    if (a === 'addCase') return out(addCase(body.data || {}));
    if (a === 'deleteCase') return out(deleteCase(body.id));
    return out({ ok: false, error: 'unknown' });
  } catch (err) { return out({ ok: false, error: String(err.message || err) }); }
}

// ---------- 시공 일정표 (팀이 쓰는 날짜별 일정 시트) ----------
// 날짜 칸(예: 10-13) 오른쪽으로 고객 한 명당 한 칸씩 적는 일정표에, 홈페이지 예약을 같은 모양으로 바로 적어 넣어요.
var SCHEDULE = {
  URL: '',              // 일정표 스프레드시트 주소. 비우면 이 스크립트가 붙어 있는 스프레드시트
  SHEET: '',            // 일정표 탭 이름. 비우면 모든 탭에서 날짜 칸을 찾아요 (예: '10월', '시공일정')
  DATE_COLS: 3,         // 날짜가 적힌 칸을 왼쪽 몇 번째 열까지에서 찾을지
  ROWS_PER_DATE: 2,     // 날짜 칸이 병합돼 있지 않을 때 한 날짜가 쓰는 줄 수
  LAST_COL: 0,          // 예약을 적을 마지막 열 번호 (0이면 시트에 내용이 있는 마지막 열, 최소 10칸)
  COLOR: '#6D9EEB',     // 홈페이지로 들어온 예약 칸 배경색 (연한 파랑)
  CONFIRMED: '#D9EAD3', // 관리자 화면에서 확정하면 바뀌는 배경색 (연두색)
  AS: '#FCE5CD'         // 홈페이지로 들어온 A/S 신청 칸 배경색 (연한 주황)
};
var LEAD_DAYS = 7;    // 고객이 고를 수 있는 가장 빠른 날짜: 오늘부터 며칠 뒤 (사이트 config.js 의 BOOKING.leadDays 와 같게)
var CHANGE_DAYS = 3;       // 시공일 며칠 전까지 고객이 앱에서 직접 바꾸거나 취소할 수 있는지 (그 뒤로는 전화)
var CHANGE_LEAD_DAYS = 7;  // 고객이 날짜를 바꿀 때 고를 수 있는 가장 빠른 날짜: 오늘부터 며칠 뒤 (config.js 의 BOOKING.changeLeadDays 와 같게)
var WAIT_MARK = '(확정 전 · 연락 필요)', OK_MARK = '(예약 확정 · 홈페이지)';
var AS_WAIT = '(A/S 접수 · 연락 필요)', AS_OK = '(A/S 확정 · 홈페이지)';
var AS_FOLDER = '칠통령 AS 사진';

// ---------- 기사님 ----------
// name: 관리자 화면에 보이는 이름, color: 일정표 칸 색,
// regions: 맡는 지역 — 새 예약의 지역이 여기 있으면 자동으로 이 기사님 색으로 칠해요 (비워 두면 직접 지정)
var TECHS = [
  { name: '기사님1', color: '#EA9999', regions: [] },
  { name: '기사님2', color: '#FFE599', regions: [] },
  { name: '기사님3', color: '#B6D7A8', regions: [] },
  { name: '기사님4', color: '#B4A7D6', regions: [] },
  { name: '기사님5', color: '#F9CB9C', regions: [] }
];
function techByName(n) { for (var i = 0; i < TECHS.length; i++) if (TECHS[i].name === n) return TECHS[i]; return null; }
function techForRegion(region) {
  if (!region) return null;
  for (var i = 0; i < TECHS.length; i++) for (var j = 0; j < TECHS[i].regions.length; j++) {
    var r = TECHS[i].regions[j];
    if (r && (region.indexOf(r) >= 0 || r.indexOf(region) >= 0)) return TECHS[i];
  }
  return null;
}
// 지역: 고객이 적은 지역, 없으면 아파트명의 첫 단어 (예: '부천 송내역 푸르지오' → 부천)
function regionOf(apt, region) {
  if (region && String(region).trim()) return String(region).trim();
  return String(apt || '').trim().split(/\s+/)[0] || '';
}
// 일정표 칸 글에서 지역 읽기 ('아파트명:' 줄의 첫 단어)
function regionInText(t) {
  var m = String(t || '').match(/아파트\s*명\s*[:：]\s*(\S+)/);
  return m ? m[1] : '';
}
// 칸 색 → 기사님 이름. '' = 기사님 없음(하늘색·연두색·흰색), null = 모르는 색이라 그대로 둠
function techForColor(bg) {
  bg = String(bg || '').toLowerCase();
  if (!bg || bg === '#ffffff' || bg === SCHEDULE.COLOR.toLowerCase() || bg === SCHEDULE.CONFIRMED.toLowerCase() || bg === SCHEDULE.AS.toLowerCase()) return '';
  var c = rgbOf(bg);
  if (!c) return null;
  var best = null, bestD = 46; // 일정표 팔레트에서 비슷한 색을 골라도 알아보게 약간의 차이는 허용
  TECHS.forEach(function (t) {
    var tc = rgbOf(t.color); if (!tc) return;
    var dd = Math.sqrt(Math.pow(c[0] - tc[0], 2) + Math.pow(c[1] - tc[1], 2) + Math.pow(c[2] - tc[2], 2));
    if (dd < bestD) { bestD = dd; best = t.name; }
  });
  return best;
}
function rgbOf(h) {
  var m = String(h || '').match(/^#?([0-9a-f]{6})$/i);
  if (!m) return null;
  return [parseInt(m[1].substr(0, 2), 16), parseInt(m[1].substr(2, 2), 16), parseInt(m[1].substr(4, 2), 16)];
}

// 일정표에서 칸 색을 바꾸면 예약 탭의 기사님도 따라 바뀌게 맞춰요
function syncTechsFromSheet() {
  var sh = sheet('book'), data = sh.getDataRange().getValues(), head = data[0];
  var cWhere = head.indexOf('일정표 칸'), cTech = head.indexOf('기사님'), cSt = head.indexOf('상태');
  if (cWhere < 0 || cTech < 0) return 0;
  var tabs = {}, changed = 0, ss = scheduleBook();
  var tabData = function (name) {
    if (tabs[name] !== undefined) return tabs[name];
    var t = ss.getSheetByName(name);
    if (!t || t.getLastRow() < 1) return (tabs[name] = null);
    var rg = t.getRange(1, 1, t.getLastRow(), Math.max(1, t.getLastColumn()));
    return (tabs[name] = { sheet: t, bg: rg.getBackgrounds(), notes: rg.getNotes() });
  };
  for (var i = 1; i < data.length; i++) {
    var id = String(data[i][0]), where = String(data[i][cWhere] || '');
    if (!where || data[i][cSt] === '취소') continue;
    var p = where.split('!'), td = tabData(p[0]);
    if (!td) continue;
    var a1 = td.sheet.getRange(p[1]), r = a1.getRow() - 1, c = a1.getColumn() - 1;
    if (!(td.notes[r] && String(td.notes[r][c]).indexOf(id) >= 0)) { // 칸이 옮겨졌으면 메모로 다시 찾기
      r = -1;
      for (var x = 0; x < td.notes.length && r < 0; x++) for (var y = 0; y < td.notes[x].length; y++) if (String(td.notes[x][y]).indexOf(id) >= 0) { r = x; c = y; break; }
      if (r < 0) continue;
      var nw = p[0] + '!' + td.sheet.getRange(r + 1, c + 1).getA1Notation();
      sh.getRange(i + 1, cWhere + 1).setValue(nw); data[i][cWhere] = nw;
    }
    var t = techForColor(td.bg[r][c]);
    if (t === null || t === String(data[i][cTech] || '')) continue;
    sh.getRange(i + 1, cTech + 1).setValue(t); data[i][cTech] = t; changed++;
  }
  return changed;
}

// setup() 이 만들어 두는 자동 실행: 일정표에 변경(색 바꾸기 포함)이 생기면 기사님 배정을 맞춰요
function onSheetChange(e) {
  clearSummary(); // 일정표를 손으로 고치면 달력의 마감 정보도 새로 계산해요
  var type = e && e.changeType;
  if (type && type !== 'EDIT' && type !== 'FORMAT') clearLayout(); // 줄·탭을 넣거나 지우면 날짜 칸 위치도 다시 찾아요
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;
  try { syncTechsFromSheet(); } finally { lock.releaseLock(); }
}

function cellColor(r) {
  var t = techByName(r['기사님']);
  if (t) return t.color;
  if (r['종류'] === 'AS') return SCHEDULE.AS;
  return r['상태'] === '확정' ? SCHEDULE.CONFIRMED : SCHEDULE.COLOR;
}

function scheduleBook() { return SCHEDULE.URL ? SpreadsheetApp.openByUrl(SCHEDULE.URL) : SpreadsheetApp.getActive(); }
function scheduleTabs() {
  var ss = scheduleBook();
  if (SCHEDULE.SHEET) { var one = ss.getSheetByName(SCHEDULE.SHEET); if (!one) throw new Error('일정표 탭 "' + SCHEDULE.SHEET + '"을 찾지 못했어요'); return [one]; }
  var mine = Object.keys(TAB).map(function (k) { return TAB[k]; });
  return ss.getSheets().filter(function (s) { return mine.indexOf(s.getName()) < 0; });
}

// 칸 값 → 'yyyy-MM-dd' (날짜가 아니면 '')
function cellDay(v) {
  if (v instanceof Date && !isNaN(v)) return Utilities.formatDate(v, 'Asia/Seoul', 'yyyy-MM-dd');
  var m = String(v || '').trim().match(/^(\d{1,2})\s*[-./월]\s*(\d{1,2})\s*일?(\s*\(.\))?$/);
  if (!m) return '';
  var mo = +m[1], da = +m[2];
  if (mo < 1 || mo > 12 || da < 1 || da > 31) return '';
  var t = new Date(), y = t.getFullYear();
  if (mo < t.getMonth() + 1 - 3) y += 1; // 연도 없이 적힌 날짜: 몇 달 전 날짜는 내년으로 봐요
  return y + '-' + ('0' + mo).slice(-2) + '-' + ('0' + da).slice(-2);
}

// 일정표 전체에서 날짜 칸을 찾아 { 'yyyy-MM-dd': {sheet, row, rows, col} } 로 돌려줘요
// 탭마다 시트를 한 번씩만 읽어서 빨라요 (날짜가 많아도 탭당 몇 번만 구글 시트를 불러요)
function scheduleIndex() {
  var idx = {};
  scheduleTabs().forEach(function (sh) {
    var last = sh.getLastRow(), lastCol = sh.getLastColumn();
    if (last < 1 || lastCol < 1) return;
    var cols = Math.min(SCHEDULE.DATE_COLS, lastCol);
    var all = sh.getRange(1, 1, last, Math.max(lastCol, cols + 10)).getValues();
    var merged = {};
    sh.getRange(1, 1, last, cols).getMergedRanges().forEach(function (m) { merged[m.getRow() + ',' + m.getColumn()] = m.getNumRows(); });
    var width = SCHEDULE.LAST_COL || Math.max(lastCol, cols + 10);
    for (var r = 0; r < all.length; r++) {
      for (var c = 0; c < cols; c++) {
        var key = cellDay(all[r][c]);
        if (!key || idx[key]) continue;
        var rows = merged[(r + 1) + ',' + (c + 1)] || SCHEDULE.ROWS_PER_DATE;
        idx[key] = { sheet: sh, row: r + 1, rows: rows, col: c + 2, lastCol: width, vals: all };
        break;
      }
    }
  });
  return idx;
}

// ---------- 빠르게 찾기: 날짜 칸 위치를 저장해 두고 그 칸만 읽어요 ----------
// 일정표가 길어져도(달이 쌓여도) 예약할 때마다 시트 전체를 읽지 않아서 느려지지 않아요
var LAYOUT_SEC = 1800; // 날짜 칸 위치를 30분 동안 기억 (줄을 넣거나 지우면 바로 다시 찾아요)
function layout(fresh) {
  var cache = CacheService.getScriptCache();
  if (!fresh) { try { var hit = cache.get('layout'); if (hit) return JSON.parse(hit); } catch (e) {} }
  var idx = scheduleIndex(), lay = {};
  Object.keys(idx).forEach(function (k) { var b = idx[k]; lay[k] = [b.sheet.getName(), b.row, b.rows, b.col, b.lastCol]; });
  try { cache.put('layout', JSON.stringify(lay), LAYOUT_SEC); } catch (e) {}
  return lay;
}
function clearLayout() { try { CacheService.getScriptCache().remove('layout'); } catch (e) {} }
function toBlock(a, ss) { var sh = (ss || scheduleBook()).getSheetByName(a[0]); return sh ? { sheet: sh, row: a[1], rows: a[2], col: a[3], lastCol: a[4] } : null; }
// 그 날짜 칸 하나 — 기억해 둔 위치가 맞는지 날짜 글자로 확인하고, 틀리면 다시 찾아요
function blockAt(day) {
  var ok = function (b) { return b && cellDay(b.sheet.getRange(b.row, b.col - 1).getValue()) === day; };
  var a = layout()[day], b = a && toBlock(a);
  if (ok(b)) return b;
  a = layout(true)[day]; // 칸이 옮겨졌거나 새 날짜면 한 번만 새로 찾아요
  b = a && toBlock(a);
  return b || null;
}

function blockRange(b) {
  var lastCol = b.lastCol || SCHEDULE.LAST_COL || Math.max(b.sheet.getLastColumn(), b.col + 9);
  return b.sheet.getRange(b.row, b.col, b.rows, lastCol - b.col + 1);
}
// 이미 읽어 둔 값으로 그 날짜 칸의 내용 (시트를 다시 부르지 않음)
function blockValues(b) {
  var out = [];
  for (var r = b.row - 1; r < b.row - 1 + b.rows; r++) {
    var row = (b.vals && b.vals[r]) || [];
    var line = [];
    for (var c = b.col - 1; c < b.lastCol; c++) line.push(row[c] === undefined ? '' : row[c]);
    out.push(line);
  }
  return out;
}
function usedCount(vals) {
  var n = 0;
  vals.forEach(function (row) { row.forEach(function (v) { if (String(v).trim() !== '') n++; }); });
  return n;
}

function bookingText(d, id) {
  var dongHo = (d.dong || '') + (d.dong && d.ho ? '-' : '') + (d.ho || '');
  if (d.kind === 'AS') {
    return [
      '[AS] 홈페이지 신청', '',
      '아파트명: ' + (d.region && String(d.apt || '').indexOf(d.region) !== 0 ? d.region + ' ' : '') + (d.apt || ''),
      '성함: ' + (d.name || '') + ' 님',
      '동호수: ' + dongHo,
      '번호: ' + (d.phone || ''),
      '증상: ' + (d.symptom || ''),
      d.memo ? '내용: ' + d.memo : '',
      d.when ? '시공 시기: ' + d.when : '',
      d.photoCount ? '사진 ' + d.photoCount + '장 (예약 탭)' : '',
      '',
      AS_WAIT
    ].filter(function (l, i, a) { return !(l === '' && (i === 0 || a[i - 1] === '')); }).join('\n');
  }
  return [
    '홈페이지 예약',
    '',
    '아파트명: ' + (d.region && String(d.apt || '').indexOf(d.region) !== 0 ? d.region + ' ' : '') + (d.apt || ''),
    '성함: ' + (d.name || '') + ' 님',
    '동호수: ' + dongHo,
    '번호: ' + (d.phone || ''),
    '제품: ' + (d.product || ''),
    '색상: ' + (d.color || ''),
    '출입방법: ' + (d.access || ''),
    d.spots ? '시공공간: ' + d.spots : '',
    d.julnun ? '줄눈 시공: ' + d.julnun : '',
    d.clean ? '입주청소: ' + d.clean : '',
    d.callTime ? '통화: ' + d.callTime : '',
    d.memo ? '남긴 말: ' + d.memo : '',
    '',
    WAIT_MARK
  ].filter(function (l, i, a) { return !(l === '' && (i === 0 || a[i - 1] === '')); }).join('\n');
}

function scheduleSummary(fresh) {
  var cache = CacheService.getScriptCache();
  if (!fresh) { var hit = cache.get('summary'); if (hit) return JSON.parse(hit); }
  var counts = {}, lay = {};
  try { lay = layout(); } catch (e) { lay = {}; }
  var today = Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd');
  // 오늘 이후 날짜 칸만, 탭마다 그 줄 범위만 한 번에 읽어요 (지난 달 칸은 읽지 않아요)
  var byTab = {};
  Object.keys(lay).forEach(function (k) {
    if (k < today) return;
    var a = lay[k], t = byTab[a[0]] || (byTab[a[0]] = { top: a[1], bottom: a[1] + a[2] - 1, right: a[4], days: [] });
    t.top = Math.min(t.top, a[1]); t.bottom = Math.max(t.bottom, a[1] + a[2] - 1); t.right = Math.max(t.right, a[4]); t.days.push(k);
  });
  var ss = Object.keys(byTab).length ? scheduleBook() : null;
  Object.keys(byTab).forEach(function (name) {
    var t = byTab[name], sh = ss.getSheetByName(name);
    if (!sh) return;
    var vals = sh.getRange(t.top, 1, t.bottom - t.top + 1, t.right).getValues();
    t.days.forEach(function (k) {
      var a = lay[k];
      counts[k] = usedCount(blockValues({ row: a[1] - t.top + 1, rows: a[2], col: a[3], lastCol: a[4], vals: vals }));
    });
  });
  // 일정표에 날짜 칸이 없는 예약도 세어 둬요
  rows('book').forEach(function (r) {
    if (r['상태'] === '취소' || r['일정표 칸'] || !r['시공일']) return;
    var d = dateStr(r['시공일']);
    counts[d] = (counts[d] || 0) + 1;
  });
  var res = { ok: true, counts: counts, closed: listClosed() };
  try { cache.put('summary', JSON.stringify(res), 600); } catch (e) {} // 10분 동안은 저장해 둔 결과로 바로 답해요 (예약·시트 수정이 있으면 바로 새로 계산)
  return res;
}
function clearSummary() { try { CacheService.getScriptCache().remove('summary'); } catch (e) {} }

// 날짜 칸 안의 첫 빈칸(위 줄 왼쪽부터)에 예약을 적어요. 적은 칸 주소를 돌려줘요
function placeInSchedule(d, id, idx) {
  var b = idx ? idx[d.day] : blockAt(d.day);
  if (!b) return { where: '', reason: 'nodate' };
  var rg = blockRange(b), vals = rg.getValues();
  if (usedCount(vals) >= PER_DAY) return { where: '', reason: 'full' };
  for (var r = 0; r < vals.length; r++) {
    for (var c = 0; c < vals[r].length; c++) {
      if (String(vals[r][c]).trim() !== '') continue;
      var cell = rg.getCell(r + 1, c + 1);
      var tech = techByName(d.tech);
      cell.setValue(bookingText(d, id)).setBackground(tech ? tech.color : (d.kind === 'AS' ? SCHEDULE.AS : SCHEDULE.COLOR)).setWrap(true)
        .setVerticalAlignment('middle').setHorizontalAlignment('center').setNote((d.kind === 'AS' ? '홈페이지 A/S ' : '홈페이지 예약 ') + id);
      return { where: b.sheet.getName() + '!' + cell.getA1Notation() };
    }
  }
  return { where: '', reason: 'full' };
}

function addBooking(d) {
  var noDay = d.kind === 'AS' && !d.day; // A/S는 고객이 날짜를 고르지 않아요 — 관리자 화면에서 칠통령이 정해요
  if (!noDay && !/^\d{4}-\d{2}-\d{2}$/.test(d.day || '')) return { ok: false, error: 'date' };
  if (!d.name || String(d.phone || '').replace(/\D/g, '').length < 10) return { ok: false, error: 'missing' };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    if (!noDay && listClosed().indexOf(d.day) >= 0) return { ok: false, error: 'full' };
    var id = (d.kind === 'AS' ? 'A' : 'B') + Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyMMddHHmmss') + Math.floor(Math.random() * 90 + 10);
    var photoUrls = [];
    (d.photos || []).slice(0, 3).forEach(function (p, i) { try { photoUrls.push(savePhoto(p, id + '-' + (i + 1) + '.jpg', AS_FOLDER).url); } catch (x) {} });
    d.photoCount = photoUrls.length;
    d.region = regionOf(d.apt, d.region);
    var auto = techForRegion(d.region);
    d.tech = auto ? auto.name : '';
    var idx = {}, placed = { where: '' };
    if (!noDay) { var blk = blockAt(d.day); if (blk) idx[d.day] = blk; }
    if (noDay) {
      // 일정표에는 아직 적지 않아요
    } else if (idx[d.day]) {
      placed = placeInSchedule(d, id, idx);
      if (placed.reason === 'full') return { ok: false, error: 'full' };
    } else {
      // 일정표에 그 날짜 칸이 아직 없으면 예약 탭에만 적고, 건수로 마감을 판단해요
      var s = scheduleSummary(true);
      if ((s.counts[d.day] || 0) >= PER_DAY) return { ok: false, error: 'full' };
    }
    clearSummary();
    sheet('book').appendRow([id, now(), d.day ? d.day : '', '접수', d.name, txt(d.phone), d.apt || '', txt(d.dong), txt(d.ho), (d.services || []).join(', '), d.quote || '', d.memo || '', d.moveIn || '', d.color || '', placed.where || '', d.region, d.tech, d.kind === 'AS' ? 'AS' : '시공', d.symptom || '', photoUrls.join(' '), d.when || '', d.product || '', d.access || '', txt(d.julnun), txt(d.clean), d.callTime || '', '']);
    return { ok: true, id: id };
  } finally { lock.releaseLock(); }
}

