      var cEd = head.indexOf('고객 수정');
      if (cEd >= 0 && changed.length) sh.getRange(i + 1, cEd + 1).setValue((r['고객 수정'] ? r['고객 수정'] + '\n' : '') + stamp + ' ' + changed.join(', '));
