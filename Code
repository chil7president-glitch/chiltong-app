      if (daysFromToday(oldDay) < CHANGE_DAYS) return { ok: false, error: 'locked' };
      var day = isAS ? oldDay : (nd.day || oldDay), moved = day !== oldDay; // A/S 방문 날짜는 칠통령이 정해요
      if (moved) {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(day) || daysFromToday(day) < CHANGE_LEAD_DAYS) return { ok: false, error: 'lead' };
        if (listClosed().indexOf(day) >= 0) return { ok: false, error: 'full' };
      }
      // 고칠 수 있는 칸만 바꿔요
      var map = isAS ? { symptom: '증상', memo: '남긴 말', when: '시공 시기', region: '지역', apt: '아파트', dong: '동', ho: '호' }
        : { product: '시공제품', color: '색상', access: '출입방법', julnun: '줄눈 일정', clean: '입주청소 일정', callTime: '통화 편한 시간', memo: '남긴 말', region: '지역', apt: '아파트', dong: '동', ho: '호' };
      var changed = [];
      if (isAS && Array.isArray(nd.photos)) { // 남길 사진(주소) + 새로 올린 사진(data:)
        var oldPh = String(r['사진'] || '').split(' ').filter(String), keep = [], added = 0;
        nd.photos.slice(0, 3).forEach(function (p, n) {
          if (oldPh.indexOf(p) >= 0) keep.push(p);
          else if (/^data:image\//.test(String(p))) { try { keep.push(savePhoto(p, id + '-e' + Date.now() + n + '.jpg', AS_FOLDER).url); added++; } catch (x) {} }
        });
        var newPh = keep.join(' '), cPh = head.indexOf('사진');
        if (cPh >= 0 && newPh !== oldPh.join(' ')) { r['사진'] = newPh; sh.getRange(i + 1, cPh + 1).setValue(newPh); changed.push('사진'); }
      }
      Object.keys(map).forEach(function (k) {
        if (nd[k] == null) return;
        var v = String(nd[k]).slice(0, 300), h = map[k], c = head.indexOf(h);
        if (c < 0 || String(r[h] == null ? '' : r[h]) === v) return;
        r[h] = v; changed.push(h);
        sh.getRange(i + 1, c + 1).setValue(['dong', 'ho', 'julnun', 'clean'].indexOf(k) >= 0 ? txt(v) : v);
      });
      var stamp = Utilities.formatDate(new Date(), 'Asia/Seoul', 'MM-dd HH:mm');
      var cell = scheduleCell(r['일정표 칸'], id, oldDay), where = String(r['일정표 칸'] || '');
      if (moved) {
