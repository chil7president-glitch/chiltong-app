}
function sheet(key) {
  var ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(TAB[key]);
  if (!sh) { sh = ss.insertSheet(TAB[key]); sh.appendRow(SHEETS[key]); sh.setFrozenRows(1); return sh; }
  var head = sh.getRange(1, 1, 1, SHEETS[key].length).getValues()[0];
  SHEETS[key].forEach(function (h, j) { if (head[j] === '' || head[j] == null) sh.getRange(1, j + 1).setValue(h); }); // 새로 생긴 열 제목 채우기
