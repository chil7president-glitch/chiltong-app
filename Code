        } else if ((scheduleSummary(true).counts[day] || 0) >= PER_DAY) return { ok: false, error: 'full' };
        if (cell) cell.clearContent().setBackground(null).clearNote();
        sh.getRange(i + 1, head.indexOf('시공일') + 1).setValue(txt(day));
        sh.getRange(i + 1, head.indexOf('상태') + 1).setValue('접수'); // 날짜가 바뀌면 시간을 다시 정해야 해서 확정 전으로
        if (cWhere) sh.getRange(i + 1, cWhere).setValue(placed.where || '');
        r['상태'] = '접수'; r['시공일'] = day; r['일정표 칸'] = placed.where || ''; where = placed.where || '';
        changed.unshift('시공일 ' + oldDay.slice(5) + '→' + day.slice(5));
        cell = placed.where ? scheduleCell(placed.where, id) : null;
      } else if (cell && changed.length) {
        var t = bookingText(rowToRec(r), id);
